      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "srghtalk-prometheus" },
      "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{job=\"srghtalk\",status=~\"5..\",node=~\"$node\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"srghtalk\",node=~\"$node\"}[5m])), 0.001)", "legendFormat": "5xx", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true }
    },
